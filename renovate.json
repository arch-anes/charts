{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended"
  ],
  "automerge": true,
  "gitIgnoredAuthors": [
    "woodpecker-bot@users.noreply.woodpecker-ci.org"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)Chart\\.yaml$"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?\\s*#\\s*renovate:\\s*image=(?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Bump truecharts image selectors.",
      "fileMatch": [
        "(^|/)values\\.yaml$"
      ],
      "matchStrings": [
        "repository:\\s*(?<depName>\\S+)\\s+tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "helmv3",
        "helm-values",
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/**"
      ],
      "groupName": "{{parentDir}}",
      "groupSlug": "chart-{{parentDir}}"
    },
    {
      "matchPackageNames": [
        "ghcr.io/ggml-org/llama.cpp"
      ],
      "versioning": "regex:^b(?<major>\\d+)$",
      "extractVersion": "^server-(?<version>b\\d+)$"
    },
    {
      "description": "Bump each chart's version by the severity of the update. llama.cpp tags are build numbers, so they stay patch.",
      "matchFileNames": [
        "charts/**"
      ],
      "bumpVersions": [
        {
          "name": "bump chart version",
          "filePatterns": [
            "{{packageFileDir}}/Chart.{yaml,yml}"
          ],
          "matchStrings": [
            "(?:^|\\n)version:[ \\t]*[\"']?(?<version>[^\"'\\s#]+)"
          ],
          "bumpType": "{{#if (includes (lookupArray upgrades \"depName\") \"ghcr.io/ggml-org/llama.cpp\")}}patch{{else if (includes (lookupArray upgrades \"updateType\") \"major\")}}major{{else if (includes (lookupArray upgrades \"updateType\") \"minor\")}}minor{{else}}patch{{/if}}"
        }
      ]
    }
  ]
}
